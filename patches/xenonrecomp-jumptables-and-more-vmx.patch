     }
 
     std::sort(functions.begin(), functions.end(), [](auto& lhs, auto& rhs) { return lhs.base < rhs.base; });
+
+    // Functions containing jump tables are often cut short by the boundary analysis, because
+    // the first blr ends them. Merge every function up to the last jump table label.
+    for (auto& [tableBase, table] : config.switchTables)
+    {
+        if (table.labels.empty())
+            continue;
+
+        auto it = std::upper_bound(functions.begin(), functions.end(), size_t(tableBase),
+            [](size_t address, const Function& fn) { return address < fn.base; });
+        if (it == functions.begin())
+            continue;
+        --it;
+
+        size_t index = it - functions.begin();
+        size_t fnBase = functions[index].base;
+        size_t end = fnBase + functions[index].size;
+        if (tableBase < fnBase || tableBase >= end)
+            continue;
+
+        size_t maxLabel = *std::max_element(table.labels.begin(), table.labels.end());
+        if (maxLabel < end)
+            continue;
+
+        size_t next = index + 1;
+        while (next < functions.size() && functions[next].base <= maxLabel)
+        {
+            end = std::max(end, functions[next].base + functions[next].size);
+            ++next;
+        }
+        end = std::max(end, maxLabel + 4);
+
+        for (size_t k = index; k < next; k++)
+        {
+            auto range = image.symbols.equal_range(functions[k].base);
+            for (auto sym = range.first; sym != range.second;)
+            {
+                if (sym->address == functions[k].base && sym->type == Symbol_Function)
+                    sym = image.symbols.erase(sym);
+                else
+                    ++sym;
+            }
+        }
+
+        functions.erase(functions.begin() + index + 1, functions.begin() + next);
+        functions[index].size = end - fnBase;
+        image.symbols.emplace(fmt::format("sub_{:X}", fnBase), fnBase, functions[index].size, Symbol_Function);
+    }
 }
 
